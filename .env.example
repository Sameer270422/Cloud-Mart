# Copy this file to .env (same directory as docker-compose.yml) and fill in
# your key. docker compose loads .env automatically - do not commit the
# real .env file (it's already gitignored).

# Required for genai-service (AI shopping assistant + semantic search).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional - defaults to claude-sonnet-5 if unset.
# ANTHROPIC_MODEL=claude-sonnet-5
